# Copy this file to  strategies/.env  and fill in the real values.
# strategies/.env is git-ignored — it NEVER gets committed or copied between machines.
# This is the LAST step: do it only when every log-only check has passed.

# From your Kite Connect app at https://developers.kite.trade  (free Personal plan)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# A label for the Zerodha account this strategy trades. Must match
# broker.account_label in strategies/configs/small_cap_dryrun.json.
ZERODHA_ACCOUNT_LABEL=ARUN_SMALLCAP

# The daily access token is written by the bot to strategies/zerodha_token.json
# after the morning tap+paste login. You do NOT set it here.
