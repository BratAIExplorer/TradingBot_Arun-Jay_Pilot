[Unit]
Description=Zepp Web API — ARUN Bot Remote Dashboard
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/zepp
EnvironmentFile=/opt/zepp/.env
ExecStart=/opt/zepp/venv/bin/uvicorn web_api:app --host 0.0.0.0 --port 8001 --workers 1
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/zepp/logs/web.log
StandardError=append:/opt/zepp/logs/web.log

[Install]
WantedBy=multi-user.target
